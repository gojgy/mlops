{
  "uid": "hw11",
  "title": "ДЗ 11 · CPU-имитатор",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "До первой части, p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,pod) (rate(inference_first_chunk_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Полный ответ, p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,pod) (rate(inference_total_seconds_bucket[1m])))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Выполняются и ожидают",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "inference_running or inference_waiting",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Завершено запросов/с",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod)(rate(inference_requests_total{status=\"ok\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Отказы и ошибки/с",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod,status)(rate(inference_requests_total{status!=\"ok\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "CPU по Pod",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{namespace=\"hw11\",container=\"api\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "RAM по Pod",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (pod)(container_memory_working_set_bytes{namespace=\"hw11\",container=\"api\"})",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Ready реплики",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hw11-prometheus"
      },
      "targets": [
        {
          "expr": "sum(hw11_pod_ready)",
          "refId": "A",
          "legendFormat": "{{pod}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
